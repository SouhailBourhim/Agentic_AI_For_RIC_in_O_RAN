    {
      "id": 6,
      "type": "timeseries",
      "title": "PRB share per slice (set by the RL runner, sums to 100 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ric_slice_prb_share",
          "legendFormat": "{{slice}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "embb"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "displayName",
                "value": "eMBB"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "urllc"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "displayName",
                "value": "URLLC"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              },
              {
                "id": "displayName",
                "value": "Best effort"
              }
