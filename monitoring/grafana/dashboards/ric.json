{
  "uid": "ric",
  "title": "Agentic RIC \u2014 live (M04a)",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "ric"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Policy in force (0 = default)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ric_policy_in_force",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
