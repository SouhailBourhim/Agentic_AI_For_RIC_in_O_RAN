-static uldlcounter_t last_pdcp_sdu_total_bytes[MAX_MOBILES_PER_GNB] = {0};
+/* agentic-ric (M10d): the previous PDCP SDU byte counters, kept PER UE (by rrc_ue_id: PDCP has no RNTI) for the
+   same reason as the M07a table below: stock v3.0.0 indexes them by the UE's position in one subscription's match
+   list, so with one subscription per S-NSSAI the UEs share slot 0. The report is whole Mb (OAI's unit, kept), and
+   the counter advances by exactly the bytes reported: the remainder under 1 Mb is carried to the next period
+   instead of dropped, so the reports add up to the real volume (stock truncation reads ~0.5 Mb/s low). */
+#define BYTES_PER_MB 125000u  // 10^6 bits / 8
+typedef struct {
+  bool used;
+  uint32_t rrc_ue_id;
+  uldlcounter_t pdcp_sdu_bytes;  // SDU bytes already reported (DRB.PdcpSduVolumeDL / DRB.PdcpSduVolumeUL)
+} pdcp_prev_t;
+static pdcp_prev_t pdcp_prev[MAX_MOBILES_PER_GNB] = {0};
+
+static pdcp_prev_t* pdcp_prev_of(const uint32_t rrc_ue_id)
+{
+  for (int i = 0; i < MAX_MOBILES_PER_GNB; i++)
+    if (pdcp_prev[i].used && pdcp_prev[i].rrc_ue_id == rrc_ue_id)
+      return &pdcp_prev[i];
+  // New UE: a free slot, or (table full of departed UEs) a slot chosen by its id. Its first report is then a
+  // delta from zero, as for any UE's first report in stock OAI.
+  int slot = rrc_ue_id % MAX_MOBILES_PER_GNB;
+  for (int i = 0; i < MAX_MOBILES_PER_GNB; i++)
+    if (!pdcp_prev[i].used) {
+      slot = i;
+      break;
+    }
+  pdcp_prev[slot] = (pdcp_prev_t){.used = true, .rrc_ue_id = rrc_ue_id};
+  return &pdcp_prev[slot];
+}
+
+/* Whole Mb in counter - *reported, and *reported advanced by exactly that many Mb (the rest is carried).
+   uint32 arithmetic, so a counter that wraps still gives the right difference. */
+static uint32_t take_whole_mb(const uint32_t counter, uint32_t* reported)
+{
+  const uint32_t new_bytes = counter - *reported;
+  const uint32_t mb = new_bytes / BYTES_PER_MB;
+  *reported += mb * BYTES_PER_MB;
+  return mb;
+}
 
