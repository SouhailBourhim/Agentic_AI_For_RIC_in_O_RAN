+/* agentic-ric (M07a): the previous values of the delta measurements, kept PER UE (by RNTI).
+   Stock v3.0.0 indexes them by the UE's position in one subscription's match list, so several
+   subscriptions (e.g. one per S-NSSAI, one UE each) all share slot 0 and compute their deltas
+   against another UE's counter. The cell PRB total is kept per UE too, so a UE's PRB % uses
+   the cell's PRBs over the same interval as its own: since that UE's previous report. */
+typedef struct {
+  bool used;
+  rnti_t rnti;
+  uldlcounter_t rlc_pdu_bytes;  // RLC PDU bytes (DRB.UEThpDl / DRB.UEThpUl)
+  uldlcounter_t total_rbs;      // UE's PRBs (RRU.PrbTotDl / RRU.PrbTotUl)
+  uint64_t cell_prb_aggr_dl;    // cell's PRBs at the UE's previous RRU.PrbTotDl
+  uint64_t cell_prb_aggr_ul;
+} ue_prev_t;
+static ue_prev_t ue_prev[MAX_MOBILES_PER_GNB] = {0};
+
+static ue_prev_t* prev_of(const rnti_t rnti)
+{
+  for (int i = 0; i < MAX_MOBILES_PER_GNB; i++)
+    if (ue_prev[i].used && ue_prev[i].rnti == rnti)
+      return &ue_prev[i];
+  // New UE: a free slot, or (table full of departed UEs) a slot chosen by RNTI. Its first
+  // report is then a delta from zero, as for any UE's first report in stock OAI.
+  int slot = rnti % MAX_MOBILES_PER_GNB;
+  for (int i = 0; i < MAX_MOBILES_PER_GNB; i++)
+    if (!ue_prev[i].used) {
+      slot = i;
+      break;
+    }
+  ue_prev[slot] = (ue_prev_t){.used = true, .rnti = rnti};
+  return &ue_prev[slot];
+}
 
