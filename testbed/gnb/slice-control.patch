+static sm_ag_if_ans_t add_slices(ul_dl_slice_conf_t const* dl)
+{
+  char why[160] = {0};
+  if (dl->len_slices != NR_SLICE_N) {
+    snprintf(why, sizeof(why), "expected %d DL slices, got %u", NR_SLICE_N, dl->len_slices);
+    return slice_answer(false, why);
+  }
+  uint32_t low[NR_SLICE_N] = {0}, high[NR_SLICE_N] = {0};
+  bool seen[NR_SLICE_N] = {false};
+  for (uint32_t i = 0; i < dl->len_slices; i++) {
+    fr_slice_t const* s = &dl->slices[i];
+    if (s->id >= NR_SLICE_N || seen[s->id]) {
+      snprintf(why, sizeof(why), "slice id %u unknown or repeated (expected 0, 1, 2)", s->id);
+      return slice_answer(false, why);
+    }
+    if (s->params.type != SLICE_ALG_SM_V0_STATIC) {
+      snprintf(why, sizeof(why), "slice %u: only STATIC ranges are supported", s->id);
+      return slice_answer(false, why);
+    }
+    seen[s->id] = true;
+    low[s->id] = s->params.u.sta.pos_low;
+    high[s->id] = s->params.u.sta.pos_high;
+  }
+  if (!nr_slice_policy_set(low, high, why, sizeof(why)))
+    return slice_answer(false, why);
+  snprintf(why, sizeof(why), "PRBs eMBB [%u,%u] URLLC [%u,%u] BE [%u,%u]", low[0], high[0], low[1], high[1], low[2], high[2]);
+  return slice_answer(true, why);
 }
 
+sm_ag_if_ans_t write_ctrl_slice_sm(void const* data)
+{
+  assert(data != NULL);
+  slice_ctrl_req_data_t const* slice_req_ctrl = (slice_ctrl_req_data_t const* )data;
+  slice_ctrl_msg_t const* msg = &slice_req_ctrl->msg;
 
+  if (msg->type == SLICE_CTRL_SM_V0_ADD)
+    return add_slices(&msg->u.add_mod_slice.dl);
+  if (msg->type == SLICE_CTRL_SM_V0_DEL) {
+    nr_slice_policy_clear();
+    return slice_answer(true, "ranges removed, stock scheduler over the whole cell");
+  }
+  return slice_answer(false, "only ADD (STATIC ranges) and DEL are supported");
+}
diff --git a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch_default_policies.c b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch_default_policies.c
index 9d765c8..6878bce 100644
--- a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch_default_policies.c
+++ b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_dlsch_default_policies.c
@@ -328,3 +328,131 @@ void nr_dl_lcid_alloc_default(const gNB_MAC_INST *mac,
   for (int lcid = 0; lcid < NR_MAX_NUM_LCID; lcid++)
     lcid_alloc[lcid] = candidate->pending_bytes_per_lcid[lcid];
 }
+
+/* ===== agentic-ric M07b: slice-aware RB allocation (see nr_slice_policy.h) ======================
+ *
+ * Each slice gets a fixed range of PRBs; inside it, its UEs are scheduled by the stock
+ * nr_dl_proportional_fair, which only places data on PRBs free in the vrb_map it is given. So we
+ * give it a copy of the map where every PRB outside the slice's range is marked busy, and merge
+ * what it allocated back. PRBs a slice does not use stay idle (hard cap, not work-conserving),
+ * like the simulator the RL policy was trained on.
+ * UEs whose first DRB has no slice we know (no DRB yet during attach, or an unknown S-NSSAI) are
+ * scheduled first, over the whole cell: that traffic is signalling, a few bytes.
+ */
+
+#include <stdatomic.h>
+#include "nr_slice_policy.h"
+
+static const nssai_t slice_nssai[NR_SLICE_N] = {{1, 0x000001}, {2, 0x000001}, {1, 0x000002}};
+#define UNSLICED NR_SLICE_N
+
+/* Bit 63: ranges active. Bits 16*i .. 16*i+15: slice i's range, low byte = first PRB, high byte =
+ * last PRB. 106 PRBs here, so 8 bits per bound is enough; nr_slice_policy_set checks < 256. */
+static _Atomic uint64_t slice_ranges = 0;
+static _Atomic int cell_bw = 0;               // carrier PRBs, learnt from the scheduler
+static _Atomic uint32_t retx_waits = 0;
+#define RANGES_ACTIVE (1ULL << 63)
+
+static int slice_of(const nr_dl_candidate_t *c)
+{
+  for (int s = 0; s < NR_SLICE_N; s++)
+    if (c->nssai.sst == slice_nssai[s].sst && c->nssai.sd == slice_nssai[s].sd)
+      return s;
+  return UNSLICED;
+}
+
+static int compare_slice(const void *a, const void *b)
+{
+  return slice_of(a) - slice_of(b);
+}
+
+bool nr_slice_policy_set(const uint32_t low[NR_SLICE_N], const uint32_t high[NR_SLICE_N], char *why, size_t len)
+{
+  int bw = atomic_load(&cell_bw);
+  if (bw == 0) {
+    snprintf(why, len, "cell bandwidth not known yet (no slot scheduled)");
+    return false;
+  }
+  uint64_t word = RANGES_ACTIVE;
+  for (int i = 0; i < NR_SLICE_N; i++) {
+    if (low[i] > high[i] || high[i] >= (uint32_t)bw) {
+      snprintf(why, len, "slice %d: range [%u, %u] not inside the cell's %d PRBs", i, low[i], high[i], bw);
+      return false;
+    }
+    if (high[i] - low[i] + 1 < NR_SLICE_MIN_PRB) {
+      snprintf(why, len, "slice %d: %u PRBs, fewer than %d", i, high[i] - low[i] + 1, NR_SLICE_MIN_PRB);
+      return false;
+    }
+    for (int j = 0; j < i; j++)
+      if (low[i] <= high[j] && low[j] <= high[i]) {
+        snprintf(why, len, "slices %d and %d overlap", j, i);
+        return false;
+      }
+    word |= ((uint64_t)(high[i] << 8 | low[i])) << (16 * i);
+  }
+  atomic_store(&slice_ranges, word);
+  return true;
+}
+
+void nr_slice_policy_clear(void)
+{
+  atomic_store(&slice_ranges, 0);
+}
+
+uint32_t nr_slice_policy_retx_waits(void)
+{
+  return atomic_exchange(&retx_waits, 0);
+}
+
+int nr_dl_slice_policy(const nr_dl_sched_params_t *params, nr_dl_candidate_t *candidates, int n_candidates)
+{
+  const NR_ServingCellConfigCommon_t *scc = params->cell->common_channels.ServingCellConfigCommon;
+  atomic_store(&cell_bw, scc->downlinkConfigCommon->frequencyInfoDL->scs_SpecificCarrierList.list.array[0]->carrierBandwidth);
+
+  uint64_t word = atomic_load(&slice_ranges);  // one read per slot: all slices see the same split
+  if (!(word & RANGES_ACTIVE))
+    return nr_dl_proportional_fair(params, candidates, n_candidates);
+
+  /* Group the candidates by slice; the caller does not depend on their order (it already sorted
+   * them by beam, and later loops over all of them). All candidates here share one beam. */
+  qsort(candidates, n_candidates, sizeof(*candidates), compare_slice);
+  int beam = n_candidates > 0 ? candidates[0].alloc_beam_idx : 0;
+  uint16_t *vrb_map = params->vrb_map[beam];
+
+  int n_scheduled = 0;
+  int start = 0;
+  /* The unsliced group sorts last; schedule it first, over the whole cell. */
+  int first_unsliced = n_candidates;
+  while (first_unsliced > 0 && slice_of(&candidates[first_unsliced - 1]) == UNSLICED)
+    first_unsliced--;
+  if (first_unsliced < n_candidates)
+    n_scheduled += nr_dl_proportional_fair(params, candidates + first_unsliced, n_candidates - first_unsliced);
+
+  for (int s = 0; s < NR_SLICE_N && n_scheduled < params->max_num_ue; s++) {
+    int end = start;
+    while (end < first_unsliced && slice_of(&candidates[end]) == s)
+      end++;
+    if (end > start) {
+      int low = (word >> (16 * s)) & 0xFF;
+      int high = (word >> (16 * s + 8)) & 0xFF;
+      uint16_t masked[MAX_BWP_SIZE];
+      for (int rb = 0; rb < MAX_BWP_SIZE; rb++)
+        masked[rb] = (rb >= low && rb <= high) ? vrb_map[rb] : 0xFFFF;
+
+      nr_dl_sched_params_t p = *params;
+      p.vrb_map[beam] = masked;
+      for (int b = 0; b < p.num_beams; b++)
+        p.n_rb_avail[b] = high - low + 1;
+      p.max_num_ue = params->max_num_ue - n_scheduled;
+      n_scheduled += nr_dl_proportional_fair(&p, candidates + start, end - start);
+
+      for (int rb = low; rb <= high; rb++)
+        vrb_map[rb] |= masked[rb];
+      for (int c = start; c < end; c++)
+        if (candidates[c].is_retx && !candidates[c].scheduled && !candidates[c].skipped)
+          atomic_fetch_add(&retx_waits, 1);
+    }
+    start = end;
+  }
+  return n_scheduled;
+}
