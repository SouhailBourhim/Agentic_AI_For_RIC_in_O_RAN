diff --git a/openair2/LAYER2/NR_MAC_gNB/nr_slice_policy.h b/openair2/LAYER2/NR_MAC_gNB/nr_slice_policy.h
new file mode 100644
index 0000000..83b8412
--- /dev/null
+++ b/openair2/LAYER2/NR_MAC_gNB/nr_slice_policy.h
@@ -0,0 +1,30 @@
+/*
+ * agentic-ric M07b: per-slice downlink PRB ranges, set over E2 (SLICE service model control).
+ *
+ * The E2 agent thread calls nr_slice_policy_set / nr_slice_policy_clear; the MAC scheduler reads
+ * the ranges every slot in nr_dl_slice_policy (gNB_scheduler_dlsch_default_policies.c). The ranges
+ * travel between the two threads as ONE 64-bit atomic word, so the scheduler never takes a lock.
+ * Kept free of MAC types so the E2 code can include it without the scheduler headers.
+ */
+
+#ifndef NR_SLICE_POLICY_H
+#define NR_SLICE_POLICY_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define NR_SLICE_N 3          // slice ids 0, 1, 2 = eMBB, URLLC, BE (table in the .c file)
+#define NR_SLICE_MIN_PRB 5    // the PF policy never allocates fewer than 5 PRBs (min_rbSize)
+
+/* Use PRBs [low[i], high[i]] (inclusive, cell PRB index) for slice i from the next slot on.
+ * Returns false and writes the reason into `why` if the ranges are invalid; nothing changes then. */
+bool nr_slice_policy_set(const uint32_t low[NR_SLICE_N], const uint32_t high[NR_SLICE_N], char *why, size_t len);
+
+/* Back to the stock proportional-fair scheduler over the whole cell. */
+void nr_slice_policy_clear(void);
+
+/* HARQ retransmissions that found no room in their slice's range since the last call (then reset). */
+uint32_t nr_slice_policy_retx_waits(void);
+
+#endif /* NR_SLICE_POLICY_H */
